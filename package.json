{
  "name": "lightspeed-astarjs",
  "version": "1.0.1",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bash -c 'source ./emsdk/emsdk_env.sh && make clean && make && node scripts/build.js'",
    "test": "npm run test:node && npm run test:browser",
    "test:node": "node node_modules/jest/bin/jest.js",
    "test:browser": "node scripts/test-browser.js"
  },
  "keywords": [
    "astar",
    "pathfinding",
    "webassembly",
    "performance",
    "game development",
    "typescript",
    "traversal",
    "graph",
    "custom",
    "fast"
  ],
  "license": "MIT",
  "description": "",
  "files": [
    "dist/index.js",
    "dist/index.mjs",
    "dist/index.d.ts",
    "dist/index.d.mts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/saqibali-2k/lightspeed-astarjs.git"
  },
  "homepage": "https://saqib-ali.com/lightspeed-astarjs/",
  "author": "Saqib Ali <saqibali.toronto@gmail.com>",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "esbuild": "^0.27.2",
    "http-server": "^14.1.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "web-worker": "^1.5.0"
  }
}